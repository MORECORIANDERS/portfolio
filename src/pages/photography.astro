---
import BaseLayout from '../layouts/BaseLayout.astro';
import photoMeta from '../data/photo-meta.json';

const images = import.meta.glob<ImageMetadata>(
  '../assets/photography/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP,gif,GIF}',
  { eager: true, import: 'default' }
);

const photos = Object.entries(images)
  .map(([path, mod]) => {
    const filename = path.split('/').pop() ?? '';
    const stem = filename.replace(/\.[^.]+$/, '');
    const meta = (photoMeta as Record<string, Record<string, string | number>>)[stem] ?? {};
    return {
      src: mod.src,
      alt: stem.replace(/[-_]/g, ' '),
      width: mod.width,
      height: mod.height,
      meta,
    };
  })
  .sort((a, b) => String(b.meta.date ?? '').localeCompare(String(a.meta.date ?? '')));
---

<BaseLayout title="摄影" description="阿城的摄影作品集。">
  <!-- Hero -->
  <section class="section photo-hero">
    <div class="container">
      <p class="eyebrow" data-reveal>Photography</p>
      <h1 data-reveal style="--reveal-delay:80ms">
        用镜头<span class="serif-italic accent">捕捉</span>瞬间。
      </h1>
      <p class="photo-sub" data-reveal style="--reveal-delay:200ms">
        光影之间，记录那些值得被留住的时刻。
      </p>
    </div>
  </section>

  <!-- Gallery -->
  <section class="section gallery-section">
    <div class="container">
      {photos.length > 0 ? (
        <div class="masonry">
          {photos.map((photo, i) => (
            <div class="masonry-item">
              <button
                class="gallery-card"
                data-lightbox-trigger
                data-index={i}
              >
                <img
                  src={photo.src}
                  alt={photo.alt}
                  loading="lazy"
                  decoding="async"
                  width={photo.width}
                  height={photo.height}
                />
              </button>
              {photo.meta.camera && (
                <p class="photo-meta">
                  <span class="meta-date">{photo.meta.date}</span>
                  <span class="meta-sep">·</span>
                  <span>{photo.meta.camera}</span>
                  {photo.meta.focal && (
                    <>
                      <span class="meta-sep">·</span>
                      <span>{photo.meta.focal} {photo.meta.aperture} {photo.meta.shutter} {photo.meta.iso}</span>
                    </>
                  )}
                </p>
              )}
            </div>
          ))}
        </div>
      ) : (
        <div class="gallery-empty" data-reveal>
          <p>照片正在路上，请稍后再来。</p>
        </div>
      )}
    </div>
  </section>

  <!-- Lightbox -->
  <div class="lightbox" data-lightbox hidden>
    <button class="lightbox-close" data-lightbox-close aria-label="关闭">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6L6 18M6 6l12 12" />
      </svg>
    </button>
    <button class="lightbox-prev" data-lightbox-prev aria-label="上一张">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 18l-6-6 6-6" />
      </svg>
    </button>
    <button class="lightbox-next" data-lightbox-next aria-label="下一张">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18l6-6-6-6" />
      </svg>
    </button>
    <div class="lightbox-content">
      <img data-lightbox-img alt="" />
    </div>
    <p class="lightbox-counter" data-lightbox-counter></p>
  </div>
</BaseLayout>

<script>
  const lightbox = document.querySelector('[data-lightbox]');
  const lightboxImg = document.querySelector('[data-lightbox-img]') as HTMLImageElement;
  const counter = document.querySelector('[data-lightbox-counter]');
  const triggers = document.querySelectorAll('[data-lightbox-trigger]');
  const photos = Array.from(triggers).map((el) => {
    const img = el.querySelector('img')!;
    return { src: img.src, alt: img.alt };
  });

  let currentIndex = 0;

  function open(index: number) {
    currentIndex = index;
    update();
    lightbox?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lightbox?.setAttribute('hidden', '');
    document.body.style.overflow = '';
  }

  function update() {
    const photo = photos[currentIndex];
    if (!photo || !lightboxImg) return;
    lightboxImg.src = photo.src;
    lightboxImg.alt = photo.alt;
    if (counter) counter.textContent = `${currentIndex + 1} / ${photos.length}`;
  }

  function prev() {
    currentIndex = (currentIndex - 1 + photos.length) % photos.length;
    update();
  }

  function next() {
    currentIndex = (currentIndex + 1) % photos.length;
    update();
  }

  triggers.forEach((trigger, i) => {
    trigger.addEventListener('click', () => open(i));
  });

  lightbox?.querySelector('[data-lightbox-close]')?.addEventListener('click', close);
  lightbox?.querySelector('[data-lightbox-prev]')?.addEventListener('click', prev);
  lightbox?.querySelector('[data-lightbox-next]')?.addEventListener('click', next);

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) close();
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox?.hasAttribute('hidden')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') prev();
    if (e.key === 'ArrowRight') next();
  });

  let touchStartX = 0;
  lightbox?.addEventListener('touchstart', ((e: TouchEvent) => {
    touchStartX = e.touches[0].clientX;
  }) as EventListener, { passive: true });
  lightbox?.addEventListener('touchend', ((e: TouchEvent) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 50) dx > 0 ? prev() : next();
  }) as EventListener, { passive: true });
</script>

<style>
  /* Hero */
  .photo-hero { padding-bottom: 0; }
  .photo-hero h1 {
    margin-top: 1rem;
    font-size: clamp(2.4rem, 1.4rem + 4vw, 4.5rem);
    max-width: 16ch;
  }
  .accent { color: var(--accent-strong); }
  .photo-sub {
    margin-top: 1rem;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.3rem);
    max-width: 40ch;
  }

  /* Masonry */
  .gallery-section { padding-top: clamp(2rem, 5vw, 4rem); }
  .masonry {
    columns: 3;
    column-gap: clamp(0.75rem, 2vw, 1.2rem);
  }
  .masonry-item {
    break-inside: avoid;
    margin-bottom: clamp(0.75rem, 2vw, 1.2rem);
  }
  .gallery-card {
    display: block;
    width: 100%;
    border: none;
    padding: 0;
    background: var(--bg-sunken);
    cursor: pointer;
    overflow: hidden;
    line-height: 0;
  }
  .gallery-card img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s var(--ease), filter 0.45s var(--ease);
    filter: saturate(0.95);
  }
  .gallery-card:hover img {
    transform: scale(1.03);
    filter: saturate(1.05);
  }

  /* Photo meta */
  .photo-meta {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.03em;
    color: var(--ink-faint);
    line-height: 1.5;
  }
  .meta-date {
    color: var(--ink-soft);
  }
  .meta-sep {
    margin: 0 0.3em;
    opacity: 0.4;
  }

  /* Empty state */
  .gallery-empty {
    text-align: center;
    padding: clamp(4rem, 10vw, 8rem) 0;
    color: var(--ink-faint);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.2rem;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox:not([hidden]) {
    opacity: 1;
  }
  .lightbox-content {
    max-width: 90vw;
    max-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox-content img {
    max-width: 100%;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 2px;
    user-select: none;
  }
  .lightbox-close {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    color: rgba(255, 255, 255, 0.7);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    transition: color 0.25s var(--ease), transform 0.25s var(--ease);
    z-index: 210;
  }
  .lightbox-close:hover {
    color: #fff;
    transform: rotate(90deg);
  }
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.6);
    background: none;
    border: none;
    cursor: pointer;
    padding: 1rem;
    transition: color 0.25s var(--ease), transform 0.25s var(--ease);
    z-index: 210;
  }
  .lightbox-prev { left: 1rem; }
  .lightbox-next { right: 1rem; }
  .lightbox-prev:hover,
  .lightbox-next:hover {
    color: #fff;
  }
  .lightbox-prev:hover { transform: translateY(-50%) translateX(-3px); }
  .lightbox-next:hover { transform: translateY(-50%) translateX(3px); }
  .lightbox-counter {
    position: absolute;
    bottom: 1.2rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 900px) {
    .masonry { columns: 2; }
  }
  @media (max-width: 540px) {
    .masonry { columns: 1; }
    .lightbox-prev,
    .lightbox-next {
      padding: 0.6rem;
    }
    .lightbox-prev { left: 0.3rem; }
    .lightbox-next { right: 0.3rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-card img { transition-duration: 0.01ms; }
    .lightbox { transition-duration: 0.01ms; }
  }
</style>
